<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Rhino 8 Windows can run on .NET Framework 4.8 (via SetDotNetRuntime) or .NET 7+.
         Rhino 8 Mac runs on .NET 7+ only. Building both covers every Rhino 8 install. -->
    <TargetFrameworks>net7.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701;NETSDK1086</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Version>0.2.0</Version>
    <Title>RhinoGotchi</Title>
    <Company>Raven</Company>
    <Description>Learn Rhino by playing: lessons, a command library and daily games in a side panel.</Description>
    <!-- Keep the git hash out of the assembly version, so it matches the package version Yak is given. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <RootNamespace>RhinoGotchi</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pixel pet art from the RhinoGotchi canvas: pose layers, LCD shadows, clothes, eating strips. -->
    <EmbeddedResource Include="Resources\Pet\*.png" LogicalName="RhinoGotchi.Pet.%(Filename).png" />
    <!-- Panel art: game cards, the Learning/Games switch and the bottom-bar icons. Resource ids: RhinoGotchi.Art.{name}.png -->
    <EmbeddedResource Include="Resources\Art\*.png" LogicalName="RhinoGotchi.Art.%(Filename).png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Compile against the oldest Rhino 8 SDK so the plugin loads in every Rhino 8 service release. -->
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" ExcludeAssets="runtime" />
    <!-- System.Drawing.Bitmap (for SVG icons) on .NET 7. Compile-only: Rhino 8 provides it at runtime. -->
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" ExcludeAssets="runtime" Condition="'$(TargetFramework)' == 'net7.0'" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net48'" />
    <!-- HttpClient for Deep Cut's judge; part of the framework on .NET 7. -->
    <Reference Include="System.Net.Http" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <!-- HttpClient for the online leaderboard. Part of the framework, but not referenced by default on net48. -->
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Side panel tab icon, loaded by Panels.RegisterPanel via this resource name. -->
    <EmbeddedResource Include="Resources\RhinoGotchi.svg" LogicalName="RhinoGotchi.Resources.RhinoGotchi.svg" />
    <!-- FinGotchi's pixel rhino, cut into layers. Resource ids: RhinoGotchi.Fin.Pets.pet{picture}-{layer}.png -->
    <EmbeddedResource Include="..\..\Rhino\Models\Klosterneuburg_light.3dm" LogicalName="RhinoGotchi.Klosterneuburg.3dm" />
    <EmbeddedResource Include="Fin\Pets\*.png" LogicalName="RhinoGotchi.Fin.Pets.%(Filename)%(Extension)" />
    <!-- The team's command dataset, read by the Command Library for descriptions. -->
    <EmbeddedResource Include="..\..\Rhino\rhino_commands_all.csv" LogicalName="RhinoGotchi.Data.rhino_commands_all.csv" Link="Data\rhino_commands_all.csv" />
    <!-- Deep Cut: the commands a guess can be, and the list of bundled models (id, forum topic, link). -->
    <EmbeddedResource Include="DeepCut\commands.txt" LogicalName="RhinoGotchi.DeepCut.commands.txt" />
    <EmbeddedResource Include="DeepCut\models.tsv" LogicalName="RhinoGotchi.DeepCut.models.tsv" />
  </ItemGroup>

  <ItemGroup>
    <!-- Command icons, copied next to the .rhp as Icons\*.svg and rendered at runtime (recolored for dark mode). -->
    <None Include="..\..\Rhino\RhinoIcons\svg\*.svg" LinkBase="Icons" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- Deep Cut models, copied next to the .rhp as DeepCut\Models\*.dcm (format: see Content/DeepCutModels.cs). -->
    <None Include="DeepCut\Models\*.dcm" CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <!-- Water Run levels saved from Rhino (levels/water in the repository), copied next to the .rhp as WaterLevels\*. -->
    <None Include="..\..\levels\water\*.*" LinkBase="WaterLevels" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Rhino sprites for the RhinoOnTheStreet tutorial, loaded from next to the .rhp. -->
    <None Include="Assets\RhinoOnTheStreet\*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
