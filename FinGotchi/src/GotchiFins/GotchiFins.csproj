<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Rhino 8 Windows can run on .NET Framework 4.8 (via SetDotNetRuntime) or .NET 7+.
         Rhino 8 Mac runs on .NET 7+ only. Building both covers every Rhino 8 install. -->
    <TargetFrameworks>net7.0;net48</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.rhp</TargetExt>
    <NoWarn>NU1701;NETSDK1086</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <Version>0.1.0</Version>
    <Title>GotchiFins</Title>
    <Company>Raven</Company>
    <Description>A newspaper-puzzle-style Rhino 8 panel that teaches you to build a finned facade: mass, profile, fin, array.</Description>
    <RootNamespace>GotchiFins</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Compile against the oldest Rhino 8 SDK so the plugin loads in every Rhino 8 service release.
         It also provides Eto.Forms, the cross-platform UI toolkit the panel is built with. -->
    <PackageReference Include="RhinoCommon" Version="8.0.23304.9001" ExcludeAssets="runtime" />
    <!-- System.Drawing.Bitmap for viewport bitmaps on .NET 7; Rhino ships the runtime copy. -->
    <PackageReference Include="System.Drawing.Common" Version="7.0.0" ExcludeAssets="runtime" Condition="'$(TargetFramework)' == 'net7.0'" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" Condition="'$(TargetFramework)' == 'net48'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Panel tab icon. Resource id: GotchiFins.Resources.GotchiFins.ico -->
    <EmbeddedResource Include="Resources\GotchiFins.ico" LogicalName="GotchiFins.Resources.GotchiFins.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- The rhino pet, cut into layers. Resource ids: GotchiFins.Pets.pet{picture}-{layer}.png -->
    <EmbeddedResource Include="Resources\Pets\*.png" LogicalName="GotchiFins.Pets.%(Filename)%(Extension)" />
    <!-- The RhinoGotchi toolbar. Rhino loads a .rui named like the plugin from the plugin's folder. -->
    <None Include="GotchiFins.rui" CopyToOutputDirectory="PreserveNewest" Condition="Exists('GotchiFins.rui')" />
  </ItemGroup>

</Project>
