{
  "rules": {
    ".read": false,
    ".write": false,
    "boards": {
      "$board": {
        ".read": true,
        ".indexOn": ["s"],
        ".validate": "$board.length <= 32",
        "$player": {
          ".write": true,
          ".validate": "$player.length <= 64 && newData.hasChildren(['s', 'n'])",
          "s": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000000" },
          "n": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 20" },
          "i": { ".validate": "newData.isString() && newData.val().length <= 16" },
          "t": { ".validate": "newData.val() == now" },
          "$other": { ".validate": false }
        }
      }
    },
    "icons": {
      "$player": {
        ".read": true,
        ".write": true,
        ".validate": "$player.length <= 64 && newData.isString() && newData.val().length <= 20000"
      }
    }
  }
}
