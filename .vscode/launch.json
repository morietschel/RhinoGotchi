{
  // Press F5 and pick a configuration. Each one builds the plugin first, then
  // starts Rhino 8 with the build output on RHINO_PACKAGE_DIRS, so Rhino loads
  // HouseTutor.rhp from bin/Debug automatically and breakpoints hit.
  // Close Rhino before rebuilding: a running Rhino locks the .rhp on Windows.
  "version": "0.2.0",
  "configurations": [
    {
      // Mac, and Windows on the default .NET 7+ runtime.
      "name": "Rhino 8 (.NET 7+) - Mac / Windows",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build net7.0",
      "osx": {
        "program": "/Applications/Rhino 8.app/Contents/MacOS/Rhinoceros",
        "args": ["-nosplash"]
      },
      "windows": {
        "program": "C:\\Program Files\\Rhino 8\\System\\Rhino.exe",
        "args": ["/netcore", "/nosplash"]
      },
      "env": {
        "RHINO_PACKAGE_DIRS": "${workspaceFolder}/src/HouseTutor/bin/Debug/net7.0"
      },
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true
    },
    {
      // Windows only: Rhino 8 on .NET Framework 4.8.
      "name": "Rhino 8 (.NET Framework) - Windows",
      "type": "clr",
      "request": "launch",
      "preLaunchTask": "build net48",
      "program": "C:\\Program Files\\Rhino 8\\System\\Rhino.exe",
      "args": ["/netfx", "/nosplash"],
      "env": {
        "RHINO_PACKAGE_DIRS": "${workspaceFolder}/src/HouseTutor/bin/Debug/net48"
      },
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "stopAtEntry": false,
      "justMyCode": true
    }
  ]
}
